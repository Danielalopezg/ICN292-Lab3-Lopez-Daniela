{
  "name": "Lab3 - Resumen diario (Parte B)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 20,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "7c0ec7c0-0dd3-4965-b627-93fe5bad4dae",
      "name": "Todos los dias 20:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "IXBEmONhnMmPPg6S",
          "cachedResultName": "registro_devoluciones"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "createdAt",
              "condition": "gte",
              "keyValue": "={{ $today.toISO() }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "696aed6d-192e-4725-9944-3a741453caf8",
      "name": "Leer registro del dia",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "count",
              "field": "id_solicitud"
            },
            {
              "aggregation": "sum",
              "field": "monto"
            }
          ]
        },
        "fieldsToSplitBy": "ruta",
        "options": {
          "continueIfFieldNotFound": true
        }
      },
      "id": "34046f25-255f-490e-a77d-09aa0993fd47",
      "name": "Resumir por ruta",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const filas = $input.all().map(i => i.json).filter(r => r.ruta);\nconst fmt = n => \"$\" + Number(n || 0).toLocaleString(\"es-CL\");\nconst total = filas.reduce((a, r) => a + (r.count_id_solicitud || 0), 0);\nconst montoTotal = filas.reduce((a, r) => a + (r.sum_monto || 0), 0);\nconst aprob = (filas.find(r => r.ruta === \"APROBACION\") || {}).count_id_solicitud || 0;\nconst tasa = total ? (100 * aprob / total).toFixed(1) + \"%\" : \"n/a\";\nconst fecha = $now.setZone(\"America/Santiago\").toFormat(\"dd-MM-yyyy\");\nlet texto;\nif (total === 0) {\n  texto = \"Resumen de devoluciones \" + fecha + \"\\n\\nHoy no se registraron solicitudes.\";\n} else {\n  const lineas = filas.map(r => \"- \" + r.ruta + \": \" + r.count_id_solicitud + \" solicitudes, \" + fmt(r.sum_monto));\n  texto = \"Resumen de devoluciones \" + fecha + \"\\n\\nSolicitudes y monto por ruta:\\n\" + lineas.join(\"\\n\") +\n    \"\\n\\nTotal del dia: \" + total + \" solicitudes, \" + fmt(montoTotal) +\n    \"\\nTasa de aprobacion automatica: \" + tasa + \" (\" + aprob + \" de \" + total + \")\";\n}\nreturn [{ json: { asunto: \"AndesHogar - Resumen diario de devoluciones \" + fecha, texto, total, montoTotal, tasa } }];"
      },
      "id": "164122cc-09c6-4351-a7b9-5fc831816119",
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "danielalopez2502@gmail.com",
        "subject": "={{ $json.asunto }}",
        "emailType": "text",
        "message": "={{ $json.texto }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "34a36b9b-6fdb-4a22-8632-6372c1905873",
      "name": "Enviar resumen (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
